<style>
  /* Базовые стили для десктопа */
  .arachnid-footer-grid {
    display: grid;
    grid-template-columns: 250px 1fr 2fr;
    gap: 2rem;
    width: 100%;
    padding-left: 37px;
  }
  .arachnid-contact-value {
    font-size: 36px;
    margin: 0 !important;
    font-weight: 500;
  }
  .arachnid-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    margin-top: auto;
  }

  /* 📱 Стили для мобильных устройств (экраны меньше 900px) */
  @media screen and (max-width: 900px) {
    .arachnid-footer {
      padding: 2rem 1.5rem !important; /* Чуть уменьшаем общие отступы по бокам */
    }
    .arachnid-footer-grid {
      grid-template-columns: 1fr; /* Делаем 1 колонку вместо 3 */
      padding-left: 0; /* Убираем жесткий левый отступ */
      gap: 2rem; /* Добавляем воздух между блоками */
    }
    .arachnid-contact-value {
      font-size: 24px; /* Уменьшаем огромный шрифт, чтобы email влез в экран */
      word-break: break-word; /* Разрешаем перенос длинного email на новую строку, если нужно */
    }
    .arachnid-footer-bottom {
      flex-direction: column-reverse; /* Ставим копирайт под политикой */
      align-items: flex-start; /* Прижимаем к левому краю */
      gap: 1.5rem;
    }
  }
</style>

